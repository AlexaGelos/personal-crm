# Starts crm-backup.service every day at 03:00 Moscow time.
# Persistent: if the server was off at that time, the backup runs when it is back
[Unit]
Description=Daily backup of the CRM production database at 03:00 Moscow time

[Timer]
OnCalendar=*-*-* 03:00:00 Europe/Moscow
Persistent=true

[Install]
WantedBy=timers.target
